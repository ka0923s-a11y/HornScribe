# Python
__pycache__/
*.py[cod]
.venv/
.venv-*/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local working dirs (benchmark envs, dumps)
.work/
benchmarks/local/

# Node / desktop app
node_modules/
*.tsbuildinfo
apps/**/dist/
/dist/
apps/**/src-tauri/target/
apps/**/src-tauri/gen/

# HornScribe runtime artifacts
cache/
benchmarks/local/
*.tmp
*.recovery

# UI-070 gate outputs (screenshots/measurements — goldens live in docs/ui-070)
apps/desktop/measurements/

# #83: built frozen engine binary (rebuilt via scripts/build_engine.py)
apps/desktop/src-tauri/resources/engine/hornscribe-engine*
# #10: vendored tool binaries (ffmpeg/ffprobe/demucs) — place locally
# before packaging per resources/tools/README.txt; never commit
apps/desktop/src-tauri/resources/tools/*.exe

# vite dev-server scratch logs
vite-*.log

# Local verification scratch — leading-underscore probe scripts, dumps,
# reference renders and repo backup bundles are never meant to land.
# Scoped to the repo root + the two scratch-heavy dirs so package files
# like `python/**/__init__.py` are untouched.
/_*
/apps/desktop/_*
/apps/desktop/src-tauri/_*
/*.bundle
benchmarks/_*
apps/desktop/scripts/ui070/_*
